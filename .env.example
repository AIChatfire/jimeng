# jimeng-service —— 全部业务配置走这里；凭据只存在于本文件（已在 .gitignore / .dockerignore）
# 首次运行：cp .env.example .env 然后填 JIMENG_SESSIONID。

# ---------------------------------------------------------------------------
# 上游凭据（**必填**）
# ---------------------------------------------------------------------------
# 即梦唯一的硬前提凭据：cookie 里的 `sessionid`。
# 实测（负对照 C/E/W2）：没有它一律 `ret=1015 login error`；
# 有它则其余 20 多个 cookie、`sign`/`a_bogus`/`msToken` **全部不需要**。
# 取值方法：浏览器登录 jimeng.jianying.com → DevTools → Application → Cookies → sessionid。
JIMENG_SESSIONID=

# 可选：整串 cookie（多带无害，但只有 sessionid 参与鉴权）。
# 留空即可；填了会被解析并与 JIMENG_SESSIONID 合并（后者优先）。
JIMENG_COOKIE=

# 可选：个人/团队空间 id。留空 = 个人空间。
JIMENG_WORKSPACE_ID=

# 上游基址（一般不用改；仅联调 mock 时改）
JIMENG_BASE_URL=https://jimeng.jianying.com

# ---------------------------------------------------------------------------
# 对外鉴权
# ---------------------------------------------------------------------------
# 逗号分隔的 API Key 白名单。**留空 = 关闭鉴权**（仅限内网/联调，启动时会打 WARNING）。
# 任务与 Key 指纹绑定：换一把 Key 读不到别人的任务（本地 404，且不发上游请求）。
API_KEYS=

# ---------------------------------------------------------------------------
# 并发与节奏（闸门）
# ---------------------------------------------------------------------------
# 同时在上游跑的生成任务数上限。**默认 1 是策略选择，不是"不知道上限"**：
# 2026-09-19 实测即梦至少容忍 4 并发生成（无 1010/1057/2020）、提交延迟不随并发上升，
# 但放宽会成倍放大积分消耗速率与风控暴露面。要放宽请连同这条实测一起带走。
JM_CONCURRENCY=1
# 两次「建任务」之间的最小间隔（秒）
JM_MIN_INTERVAL=0
# 每 60s 允许的「建任务」次数上限（0 = 不限）
JM_PER_MINUTE=0
# 命中风控后的静默冷却秒数（冷却期内不发任何请求；重试会延长标记）
JM_COOLDOWN=600

# ---------------------------------------------------------------------------
# 轮询与超时
# ---------------------------------------------------------------------------
# 轮询任务的间隔（秒）与单轮上限。上游自报轮询间隔 30s，实测 4 张约 19s 完成，
# 故 2s 起轮即可，不必等 30s。
JIMENG_POLL_INTERVAL=2.0
# 起轮前的宽限（秒）：刚提交时上游可能还没落库，不必立刻开始打
# 建任务后、首次轮询前的等待。默认 0.2s —— 曾是 3.0，占端到端 52%。
# 为什么可以这么小：早问一次是**零代价**的（上游没落库就回 init 非终态），晚问才是代价。
POLL_GRACE=0.2
# 任务总超时（秒）：超过后本地判 FAILURE(expired)，不再打上游
TASK_TIMEOUT=1800
# 后台协调器（推进任务到终态的唯一执行者）—— 本服务**必须开启**
COORDINATOR_ENABLED=1
COORDINATOR_TICK=1.0
# 协调器租约（秒）：多数派唯一，防止多 worker 重复提交/重复计费
COORDINATOR_LEASE=30

# ---------------------------------------------------------------------------
# 持久化（PostgreSQL）
# ---------------------------------------------------------------------------
# 任务库 DSN。**本服务只支持 PostgreSQL** —— 刻意不留 SQLite/内存兜底：
# 多一个后端就多一套"行为略有差异"的路径，而任务库是事实源。
TASK_DB=postgresql+psycopg2://jimeng:jimeng@127.0.0.1:5432/jimeng
TASK_DB_POOL_SIZE=5
TASK_DB_MAX_OVERFLOW=10
# 长驻协调器线程必须开 pre_ping：否则 PG 重启/空闲断开会让我们拿到死连接
TASK_DB_POOL_PRE_PING=1
TASK_DB_POOL_RECYCLE=1800
TASK_DB_CONNECT_TIMEOUT=10
# 任务保留天数（上游侧任务记录保留 7 天）
TASK_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# 输入图处理
# ---------------------------------------------------------------------------
MAX_DOWNLOAD_BYTES=33554432
MAX_INPUT_BYTES=20971520
NORMALIZE_UPLOADS=1
NORMALIZE_MAX_SIDE=4096
NORMALIZE_MAX_BYTES=4194304

# ---------------------------------------------------------------------------
# 可观测性（logfire 出 trace / loguru 出日志；未配 token 时只在本地留 span）
# ---------------------------------------------------------------------------
# Logfire write token。留空 = 不上报，启动时会在 stderr 明确说明原因。
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=
OTEL_SERVICE_NAME=jimeng-service
# 1 = 把上游原始报文绑成 span 属性（默认开）。
# 🔴 观测面**不脱敏**：上下游明细、任务 id、告警原样上报，不做任何事后改写。
# 「密钥不上报」是**另一条**纪律，靠"凭据在取值处就不进属性"实现（见
# app/observability.py 的口径一节），而不是靠事后过滤。
OTEL_CAPTURE_UPSTREAM=1
# 脱敏开关，**默认 0**。打开只会启用 logfire SDK 自带的 scrubber，
# 而它按值子串命中 credential/token/auth ⇒ 即梦的 TOS 预签名产物 URL
# （必含 X-Tos-Credential=）会被整条打成 [Scrubbed due to 'Credential']，
# 面板直接不可读。除非你要对外分享 trace，否则别开。
OTEL_SCRUBBING=0

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8200
# 单进程是架构约束：节奏闸门与协调器租约都是进程内/单主语义（见 README「扩容前必读」）
WORKERS=1
# 同步接口（POST /v1/images/generations）的**总等待预算**（秒）：创建+轮询合并，
# 超过就降级回 202 + task_id（调用方转异步轮询，任务不受影响）。默认 300。
# 🔴 必须**小于** GUNICORN_TIMEOUT 与生产 nginx 的 proxy_read_timeout。
SYNC_MAX_WAIT=300
# 🔴 必须**大于** SYNC_MAX_WAIT：同步请求最长阻塞 300s，若等于 300 会被判"卡死
# worker"杀掉（客户端拿到断连，而非降级响应）。360 = 300 预算 + 60s 余量。
# ⚠️ 生产 nginx 侧同样要配 proxy_read_timeout ≥ 300 + 余量（默认 60s 会掐断）。
GUNICORN_TIMEOUT=360
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# docker compose 部署（`docker compose up -d`）
# ---------------------------------------------------------------------------
# ⚠️ 上面这些是**应用**配置；下面这几个是**给 compose 编排用的**，
# 两者在同一个 `.env` 里。compose 会用它做 ${} 插值，也会注入进容器。
#
# 🔴 `POSTGRES_PASSWORD` 是 compose 里 `${POSTGRES_PASSWORD:?}` **强制要求**的：
# 没填的话 compose 直接报「POSTGRES_PASSWORD 必须设置」起不来。
# 换句话说 `cp .env.example .env` 之后**必须**把这一项填掉，否则部署会停在这一步。
# （`.env` 已被 gitignore，所以新克隆的仓库一定没有它 —— 这一步不能省。）
POSTGRES_USER=jimeng
POSTGRES_PASSWORD=
POSTGRES_DB=jimeng
# ⚠️ 刻意**没有** POSTGRES_PORT：数据库不发布到宿主端口。
# 应用在 compose 内网走 `db:5432`；发布宿主端口只会制造冲突
# （本机 5432 常年被别的项目占着，`compose up` 会失败在 port already allocated）。
# 要在宿主上做管理：docker compose exec db psql -U jimeng -d jimeng
# 服务端口。默认绑 0.0.0.0（容器要能被外部访问）；若要再接到反代，
# 建议改成只让反代能连的形态。
JIMENG_PORT=8200
